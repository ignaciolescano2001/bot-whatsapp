OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
SUPABASE_DATABASE_URL=postgres://...

# Número en formato E.164 sin "@s.whatsapp.net" (ya no es un JID de Baileys).
NOTIFY_WHATSAPP_JID=5493548465498

# WhatsApp Cloud API (Meta) — ver developers.facebook.com > tu app > WhatsApp > API Setup
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_OWNER_NOTIFICATION=notificacion_dueno
WHATSAPP_GRAPH_API_VERSION=v21.0

# Autenticación del panel (obligatorias) — ver README, sección Seguridad.
# PANEL_PASSWORD: la contraseña con la que entra el dueño al panel.
# PANEL_SESSION_SECRET: clave para firmar la cookie de sesión, generá una con
# `openssl rand -hex 32` y no la compartas.
PANEL_PASSWORD=
PANEL_SESSION_SECRET=
